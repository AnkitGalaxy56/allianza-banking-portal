# Development only. USE_MOCK is ignored (forced off) in production builds.
VITE_APP_NAME=Allianza Banking Portal
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_API_TIMEOUT_MS=20000
# true  = no backend needed, temporary login + fake data
# false = call the real API at VITE_API_BASE_URL
VITE_USE_MOCK_API=true
# Bank used on the login page when no ?bank= param / subdomain is present
VITE_DEFAULT_BANK_CODE=sample-urban